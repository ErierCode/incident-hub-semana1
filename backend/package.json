{
  "name": "@incident-hub/backend",
  "version": "0.2.0",
  "private": true,
  "description": "API REST de IT Incident Hub",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "lint": "eslint .",
    "test": "jest --coverage"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "eslint": "^9.30.0",
    "globals": "^16.3.0",
    "jest": "^30.0.0",
    "pg-mem": "^3.0.5",
    "supertest": "^7.1.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text-summary",
      "cobertura",
      "lcov"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js",
      "!src/db/migrate.js"
    ]
  }
}
